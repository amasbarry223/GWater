# Variables à renseigner dans Vercel (Settings > Environment Variables)
# ————————————————————————————————————————————————————————————————

# Passerelle OpenWA (hébergée sur votre VPS)
OPENWA_URL=https://wa.votre-domaine.com
OPENWA_API_KEY=op_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
OPENWA_WEBHOOK_SECRET=une-chaine-aleatoire-longue

# Compte de service Firebase Admin (JSON brut ou encodé en base64)
FIREBASE_SERVICE_ACCOUNT=

# Secret pour sécuriser /api/cron/relances (Vercel Cron l'envoie automatiquement)
CRON_SECRET=une-chaine-aleatoire-longue

